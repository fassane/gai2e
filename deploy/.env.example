# /opt/gai2e/<env>/.env — créé une fois à la main sur le VPS (chmod 600).
# IMAGE_REGISTRY et IMAGE_TAG sont fournis par la CI au moment du déploiement.

POSTGRES_PASSWORD=change-me

# Ports sur 127.0.0.1, différents entre recette et prod (cible du vhost Nginx)
API_PORT=3300
WEB_PORT=3301
POSTGRES_PORT=5450

# Authentification : secret propre à l'environnement (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me
# URL publique du site, utilisée dans les liens des emails
WEB_URL=https://recette.gai2e.example

# Emails (mot de passe oublié...) : Resend, expéditeur sur un domaine vérifié dans Resend
RESEND_API_KEY=re_change-me
MAIL_FROM="GAI2E Conseils <no-reply@gai2e.example>"

# Variables applicatives supplémentaires (clé AES, stockage objet...) à ajouter ici
# au fil des étapes ; elles sont injectées dans l'api.
