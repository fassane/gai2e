# /opt/gai2e/<env>/.env — créé une fois à la main sur le VPS (chmod 600).
# IMAGE_REGISTRY et IMAGE_TAG sont fournis par la CI au moment du déploiement.

POSTGRES_PASSWORD=change-me

# Ports sur 127.0.0.1, différents entre recette et prod (cible du vhost Nginx)
API_PORT=3300
WEB_PORT=3301
POSTGRES_PORT=5450

# Variables applicatives supplémentaires (secret JWT, clé AES, stockage objet, fournisseur email...)
# à ajouter ici au fil des étapes ; elles sont injectées dans l'api.
