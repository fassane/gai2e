DATABASE_URL=postgresql://gai2e:gai2e@localhost:5434/gai2e
REDIS_URL=redis://localhost:6380
PORT=3000

# Authentification
# Secret de signature des jetons d'accès (JWT) : une longue chaîne aléatoire, différente par environnement
# (openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-only-change-me
# Durée de vie du jeton d'accès (secondes), de la session (jours) et du lien de réinitialisation (minutes)
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60

# URL du site, utilisée dans les liens des emails
WEB_URL=http://localhost:4200

# Emails : Resend (clé API sur resend.com/api-keys), ou à défaut un serveur SMTP.
# Sans l'un ni l'autre, ils sont seulement affichés dans les logs de l'api.
# RESEND_API_KEY=re_...
# SMTP_URL=smtp://utilisateur:mot-de-passe@smtp.exemple.com:587
# Expéditeur : avec Resend, sur un domaine vérifié (ou onboarding@resend.dev pour tester,
# qui n'envoie qu'à l'adresse du compte Resend)
MAIL_FROM="GAI2E Conseils <no-reply@gai2e.local>"
